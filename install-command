#!/bin/sh
set -eu

project_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
launcher="$project_dir/pomodoro"
user_bin="$HOME/.local/bin"

check_destination() {
  destination=$1
  if [ -L "$destination" ] && [ "$(readlink "$destination")" = "$launcher" ]; then
    return
  fi
  if [ -e "$destination" ] || [ -L "$destination" ]; then
    printf 'Cannot install: %s already exists.\n' "$destination" >&2
    exit 1
  fi
}

check_destination "$user_bin/pomodoro"
check_destination "$HOME/pomodoro"
mkdir -p "$user_bin"
[ -L "$user_bin/pomodoro" ] || ln -s "$launcher" "$user_bin/pomodoro"
[ -L "$HOME/pomodoro" ] || ln -s "$launcher" "$HOME/pomodoro"

if ! grep -Fq '# Pomodoro Pal command' "$HOME/.zshrc" 2>/dev/null; then
  cat >> "$HOME/.zshrc" <<'EOF'

# Pomodoro Pal command
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi

printf 'Installed. Open a new Terminal window and run: pomodoro\n'
printf 'You can also run ~/pomodoro from any folder.\n'
